# Fallback webhook — used when no team-specific webhook is set
DEBUG_WEBHOOK_URL=https://hooks.slack.com/services/...

# Team-specific webhooks — set the one matching your instance's Team freeform tag
# Tag value "ML" → ML_TEAM_WEBHOOK_URL, "Data" → DATA_TEAM_WEBHOOK_URL, etc.
ML_TEAM_WEBHOOK_URL=https://hooks.slack.com/services/...
DATA_TEAM_WEBHOOK_URL=https://hooks.slack.com/services/...
